{
    "name": "marlink-pra-api",
    "version": "3.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "db:start:local": "sh scripts/start-local-docker-db.sh pra-local-db-container mariadb pra rootpasswordpra 3306",
        "docker:build:api": "docker build --platform='linux/amd64' . -t pra-api",
        "docker:tag:api": "docker tag pra-api:latest shamrock-nexus.cdn-vas.net/marlink-pra-api:${npm_package_version}",
        "docker:prepare:api": "npm run docker:build:api && npm run docker:tag:api",
        "docker:login:marlink": "docker login shamrock-nexus.cdn-vas.net -u shamrock -p marlinkdockerpassword",
        "docker:push:api": "docker push shamrock-nexus.cdn-vas.net/marlink-pra-api:${npm_package_version}",
        "publish:api": "npm run docker:prepare:api && npm run docker:login:marlink && npm run docker:push:api"
    },
    "dependencies": {
        "@nestjs-modules/mailer": "^2.0.2",
        "@nestjs/axios": "^4.0.0",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.0.1",
        "@nestjs/cqrs": "^11.0.3",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/schedule": "^6.1.0",
        "@nestjs/terminus": "^11.0.0",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/typeorm": "^11.0.0",
        "axios": "^1.8.4",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "compression": "^1.8.1",
        "handlebars": "^4.7.8",
        "helmet": "^8.1.0",
        "mjml": "^4.18.0",
        "mysql2": "^3.14.1",
        "nodemailer": "^7.0.5",
        "passport": "^0.7.0",
        "passport-headerapikey": "^1.2.2",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "typeorm": "^0.3.28",
        "uuid": "^11.1.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.39.2",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/swagger": "^11.1.2",
        "@nestjs/testing": "^11.0.1",
        "@swc/cli": "^0.6.0",
        "@swc/core": "^1.15.5",
        "@types/bcrypt": "^5.0.2",
        "@types/compression": "^1.8.1",
        "@types/express": "^5.0.0",
        "@types/helmet": "^0.0.48",
        "@types/jest": "^29.5.14",
        "@types/mjml": "^4.7.4",
        "@types/node": "^22.19.3",
        "@types/nodemailer": "^6.4.17",
        "@types/passport-jwt": "^4.0.1",
        "@types/passport-local": "^1.0.38",
        "@types/supertest": "^6.0.2",
        "@types/uuid": "^10.0.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^16.0.0",
        "jest": "^29.7.0",
        "prettier": "^3.7.4",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.50.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coveragePathIgnorePatterns": [
            "\\/src\\/main\\.ts",
            "index\\.ts",
            "\\.module\\.ts",
            "\\.command\\.ts",
            "\\.query\\.ts",
            "\\.handler\\.ts",
            "\\.dto-input\\.ts",
            "\\.dto-output\\.ts",
            "\\.entity\\.ts"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
