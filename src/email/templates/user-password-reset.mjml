<mjml>
    <mj-body background-color="#f5f7fa">
        <mj-section background-color="#ffffff" padding="20px">
            <mj-column>
                <mj-text font-size="20px" font-weight="bold" color="#333333"> Reset Your Password </mj-text>

                <mj-text font-size="14px" color="#555555" line-height="1.5">
                    Hello {{name}},<br /><br />
                    Click the button below to reset your password. This link will expire in {{expiryMinutes}} minutes.
                </mj-text>

                <mj-button background-color="#007BFF" color="#ffffff" href="{{resetUrl}}"> Reset Password </mj-button>

                <mj-text font-size="12px" color="#888888" line-height="1.4">
                    If you didn’t request this, you can safely ignore this email.
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
