<mjml>
    <mj-head>
        <mj-title>Marlink PRA – Admin Console Access</mj-title>
        <mj-preview>Your Marlink PRA Admin Console login credentials</mj-preview>

        <mj-attributes>
            <mj-all font-family="Arial, Helvetica, sans-serif" />
            <mj-section padding="16px" />
            <mj-column padding="0" />
            <mj-text align="left" padding="0 0 12px 0" line-height="1.6" />
            <mj-image align="left" padding="12px 0 0 0" />
        </mj-attributes>
    </mj-head>

    <mj-body>
        <mj-section>
            <mj-column>
                <mj-text>Dear&nbsp;{{displayName}},</mj-text>

                <mj-text>Welcome to the Marlink PRA Admin Console.</mj-text>

                <mj-text>
                    You have been granted access to the PRA platform. Below are your login credentials:<br />
                </mj-text>

                <mj-text>
                    <strong>Console URL:</strong>
                    <a href="{{praConsoleUrl}}">{{praConsoleUrl}}</a><br />
                    <strong>Username:</strong> {{username}}<br />
                    <strong>Password:</strong>
                    <span style="font-family: 'Courier New', Courier, monospace">{{password}}</span><br />
                    <strong>Role:</strong> {{role}}<br />
                </mj-text>

                <!-- <mj-text>
                    🔐 <strong>Important:</strong><br />
                    For security reasons, we strongly recommend that you change your password immediately after your
                    first login.
                </mj-text> -->

                <mj-text>
                    If you experience any issues or have questions, feel free to contact the Marlink Service Desk at
                    <a href="mailto:servicedesk@marlink.com">servicedesk@marlink.com</a>.
                </mj-text>

                <mj-text padding="0">
                    Best regards,<br />
                    The Marlink PRA Team
                </mj-text>

                <mj-spacer height="12px" />

                <!-- <mj-image
                    src="data:image/svg+xml;base64,"
                    alt="Marlink"
                    align="left"
                    width="240px"
                    padding="16px 0 0 0"
                /> -->
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
