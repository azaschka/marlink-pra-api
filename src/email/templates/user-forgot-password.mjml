<mjml>
    <mj-head>
        <mj-title>Marlink PRA – Your New Password</mj-title>
        <mj-preview>Your PRA new password</mj-preview>
        <mj-attributes>
            <mj-all font-family="Arial, Helvetica, sans-serif" />
            <mj-section padding="16px" />
            <mj-column padding="0" />
            <mj-text align="left" padding="0 0 12px 0" line-height="1.6" />
            <mj-image align="left" padding="12px 0 0 0" />
        </mj-attributes>
    </mj-head>

    <mj-body>
        <mj-section>
            <mj-column>
                <mj-text>Hello {{ username }},</mj-text>

                <mj-text>
                    As requested, your password has been reset. Here are your updated login credentials:<br />
                </mj-text>

                <mj-text>
                    <strong>Username:</strong> {{ username }}<br />
                    <strong>New Password:</strong>
                    <span style="font-family: 'Courier New', Courier, monospace">{{ password }}</span
                    ><br />
                </mj-text>

                <mj-text> Please log in using this password and change it immediately for security reasons. </mj-text>

                <mj-text>
                    If you encounter any issues or have questions, please contact the Marlink Service Desk at
                    <a href="mailto:servicedesk@marlink.com">servicedesk@marlink.com</a>.
                </mj-text>

                <mj-text padding="0">
                    Best regards,<br />
                    The Marlink PRA Team
                </mj-text>

                <mj-spacer height="12px" />
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
