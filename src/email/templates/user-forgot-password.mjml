<mjml>
    <mj-body background-color="#f5f7fa">
        <mj-section background-color="#ffffff" padding="20px">
            <mj-column>
                <mj-text font-size="20px" font-weight="bold" color="#333333"> Your New Password </mj-text>

                <mj-text font-size="14px" color="#555555" line-height="1.5">
                    Hello {{username}},<br /><br />
                    As requested, we’ve reset your password. Here is your new password:
                </mj-text>

                <mj-text font-size="16px" font-weight="bold" color="#007BFF"> {{password}} </mj-text>

                <mj-text font-size="12px" color="#888888" line-height="1.4" padding-top="15px">
                    Please log in using this password and change it immediately for security reasons.
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
