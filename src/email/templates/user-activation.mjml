<mjml>
    <mj-head>
        <mj-title>PRA Portal</mj-title>
    </mj-head>
    <mj-body background-color="#f5f7fa">
        <mj-section>
            <mj-column>
                <mj-text font-size="20px" font-weight="bold"> Hi {{username}}, </mj-text>

                <mj-text> Welcome to the PRA Portal. </mj-text>

                <mj-text font-size="14px" color="#555555" line-height="1.5">
                    Here is your password:
                </mj-text>

                <mj-text font-size="16px" font-weight="bold" color="#007BFF"> {{password}} </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
