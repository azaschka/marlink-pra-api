<mjml>
    <mj-head>
        <mj-title>PRA Portal</mj-title>
    </mj-head>
    <mj-body background-color="#f5f7fa">
        <mj-section>
            <mj-column>
                <mj-text font-size="20px" font-weight="bold"> Hi {{name}}, </mj-text>

                <mj-text> Welcome to the PRA Portal. </mj-text>

                <mj-button href="{{activationUrl}}" background-color="#0070f3"> Activate your account </mj-button>

                <mj-text font-size="12px" color="#8898aa">
                    If the button doesn’t work, paste this link in your browser:<br />
                    {{activationUrl}}
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
